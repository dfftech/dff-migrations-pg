# Promote tenants z-order (all tenants)
curl -sS "http://localhost:4000/migration/tenants/z-order/promote/all" | jq


# Promote a single tenant (e.g. local) via the tenants track
curl -sS "http://localhost:4000/migration/tenants/0003/promote/local" | jq

# Promote tenants z-order for a single tenant
curl -sS "http://localhost:4000/migration/tenants/z-order/promote/local" | jq

###
GET http://localhost:4000/migration/tenants/z-order/promote/all

###
GET http://localhost:4000/migration/tenants/z-order/promote/local

###
GET http://localhost:4000/migration/tenants/0004/promote/local


# Tenant-specific shortcut (not core) — execute only that tenant, not all tenants
curl -sS "http://localhost:4000/migration/local/0000/promote" | jq
curl -sS "http://localhost:4000/migration/local/z-order/promote" | jq

curl -sS "http://localhost:4000/migration/abcd/0000/promote" | jq
curl -sS "http://localhost:4000/migration/abcd/z-order/promote" | jq
